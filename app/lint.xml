<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!--
        The chat SDK has code that posts notifications, which lint wants POST_NOTIFICATIONS for. That
        permission is removed on purpose (AndroidManifest.xml): push is off in the SDK
        (ChatClient.Builder keeps pushNotificationsEnabled = false), so nothing in the app ever
        posts a notification. Only this one check, only for the manifest (docs/adr/0011-messenger.md).
    -->
    <issue id="NotificationPermission">
        <ignore path="src/main/AndroidManifest.xml" />
    </issue>
</lint>
