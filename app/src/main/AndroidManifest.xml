<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The manifests of the map libraries (MapLibre, Yandex MapKit) ask for the location and for
        the Wi-Fi state, and MapKit for the right to change it. A route is only looked at, never
        located (docs/adr/0009-route-map-and-analysis.md). The one place the
        app reads is the approximate one, once and only when the person taps "use my phone" for the
        area of rides near me (docs/adr/0018-nearby-rides.md): no precise location, no background
        location, no Wi-Fi state and no service.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" tools:node="remove" />

    <!-- A phone without location hardware is no reason to hide the app: the area is chosen on the site. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!--
        The messenger's SDK (Stream Chat) asks for more than a text chat with photos needs: the
        microphone (voice messages are off) and a boot receiver and a foreground service (no
        background polling and no service: docs/adr/0011). Photos come from the system Photo
        Picker, which needs no permission at all. The notification permission is the app's own
        and is asked for only when the person agrees to push (docs/adr/0015).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!--
        No cloud backup and no device-to-device transfer of app data: the refresh token is
        encrypted with a Keystore key that never leaves the device, and nothing else is worth
        restoring (the server holds the data). docs/architecture.md, "Tokens".
    -->
    <application
        android:name=".ColaBikeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ColaBike"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Return of the native Yandex ID flow (cola #304): a verified App Link only. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="colabike.ru"
                    android:path="/app/auth"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
            Where a tap on the app's own notification lands. Not exported: only the notification's
            PendingIntent can start it, so no other app can feed the app a destination through it.
        -->
        <activity
            android:name=".push.NotificationTapActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
            Where RuStore delivers a message (docs/adr/0017). Exported because the RuStore
            application binds to it from outside; whatever arrives is checked in full by
            PushHandler before anything is shown. Without a project of the owner's the SDK is
            never started and nothing arrives.
        -->
        <service
            android:name=".push.ColaPushService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="ru.rustore.sdk.pushclient.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Components the messenger's SDK brings and the app never starts (docs/adr/0011). -->
        <!-- MissingClass: these live in the libraries' runtime classpath only; they are removed. -->
        <provider
            android:name="io.getstream.android.push.delegate.AndroidPushDelegateProvider"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="io.getstream.chat.android.client.receivers.NotificationMessageReceiver"
            tools:node="remove" />
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <!-- The Compose tooling comes along with the SDK, and its preview activity is exported. -->
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            tools:node="remove" />
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <!-- It would ask for the notification permission when an activity opens. -->
            <meta-data
                android:name="io.getstream.android.push.permissions.PushPermissionsInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
