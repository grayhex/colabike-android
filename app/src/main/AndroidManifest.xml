<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        The map library's own manifest asks for the location and for the Wi-Fi state. A route is
        only looked at, never located: no location permission and no background service
        (docs/adr/0009-route-map-and-analysis.md).
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!--
        The messenger's SDK (Stream Chat) asks for more than a text chat with photos needs: the
        microphone (voice messages are off), notifications and a boot receiver and a foreground
        service (there is no push, no background polling and no service: docs/adr/0011). Photos
        come from the system Photo Picker, which needs no permission at all.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!--
        No cloud backup and no device-to-device transfer of app data: the refresh token is
        encrypted with a Keystore key that never leaves the device, and nothing else is worth
        restoring (the server holds the data). docs/architecture.md, "Tokens".
    -->
    <application
        android:name=".ColaBikeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ColaBike"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Return of the native Yandex ID flow (cola #304): a verified App Link only. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="colabike.ru"
                    android:path="/app/auth"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Components the messenger's SDK brings and the app never starts (docs/adr/0011). -->
        <!-- MissingClass: these live in the libraries' runtime classpath only; they are removed. -->
        <provider
            android:name="io.getstream.android.push.delegate.AndroidPushDelegateProvider"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="io.getstream.chat.android.client.receivers.NotificationMessageReceiver"
            tools:node="remove" />
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <!-- The Compose tooling comes along with the SDK, and its preview activity is exported. -->
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            tools:node="remove" />
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <!-- It would ask for the notification permission when an activity opens. -->
            <meta-data
                android:name="io.getstream.android.push.permissions.PushPermissionsInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
